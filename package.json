{
  "name": "vitest-environment-prisma-postgres",
  "version": "2.0.0",
  "license": "MIT",
  "author": "Christoph Werner <christoph@codepunkt.de>",
  "description": "Vitest environment for Prisma & PostgreSQL designed for fast integration tests: seed your database once with production-like data, then run each test in a transaction that is rolled back after execution. Tests remain isolated without expensive reseeding.",
  "type": "module",
  "packageManager": "pnpm@12.18.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/codepunkt/vitest-environment-prisma-postgres"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsup",
    "format": "biome format --write",
    "format:check": "biome format",
    "lint": "biome lint",
    "prepare": "husky",
    "release": "dotenv -e .env -- release-it",
    "test": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "test:dist": "node --test test/package/load-client.mjs"
  },
  "keywords": [
    "vitest",
    "prisma",
    "postgres",
    "prisma orm",
    "postgesql",
    "test",
    "testing",
    "test isolation",
    "transaction"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "import": "./dist/index.js"
    },
    "./hooks": {
      "types": "./dist/hooks.d.ts",
      "require": "./dist/hooks.js",
      "import": "./dist/hooks.js"
    },
    "./setup": {
      "require": "./dist/setup.js",
      "import": "./dist/setup.js"
    }
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.6",
    "@prisma/adapter-pg": "7.10.1",
    "@release-it/conventional-changelog": "12.0.2",
    "@types/node": "26.6.6",
    "@vitest/coverage-v8": "5.1.0",
    "dotenv-cli": "11.1.0",
    "husky": "9.1.7",
    "prisma": "7.10.1",
    "release-it": "21.1.2",
    "tsup": "9.0.0",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  },
  "peerDependencies": {
    "@prisma/adapter-pg": ">=4 <8",
    "prisma": ">=4 <8",
    "vitest": ">=4.1 <6"
  },
  "files": [
    "CHANGELOG.md",
    "dist"
  ]
}
